o": "2026-09-25T14:54:02-03:00"}, {"titulo": "Capital de trabalho usa realizado •• e o líquido é 49,54", "porque": "Duas fontes dão números diferentes para o mesmo realizado (diferença de •• US$). O capital de trabalho de 439,96 tem de sair de uma fonte única.", "t_iso": "2026-09-25T14:24:23-03:00"}, {"titulo": "Bateria com andar_registo -1 (fora do REGISTO)", "porque": "O vigia.json mostra andar_registo=-1 para a bateria (T19); o posto:Tesouraria-Bateria está partido sem entrada no REGISTO de mercado/predio.py", "t_iso": "2026-09-25T11:54:49-03:00"}, {"titulo": "Prova de vida do Tesouraria-Vivo aponta para painel.json", "porque": "O predio.json dá o Vivo e o Vivo-247 como ok (resultado 0, 11:22), mas a contagem única marca-os como partidos. O predio.py:547 diz que escrevem vivo.json e não painel.json. São 2 falsos partidos.", "t_iso": "2026-09-25T11:24:25-03:00"}, {"titulo": "Bateria: separar teste falhado de bateria partida", "porque": "O agendador marca erro sem traceback e com a saída fresca (3,58 h). O mais provável é o pytest sair com código ≠0 por causa da regra desequilíbrio partida. É um vermelho que não se resolve a reiniciar", "t_iso": "2026-09-25T11:24:25-03:00"}, {"titulo": "Vigia cobre 181 de 182 do REGISTO", "porque": "A meta-supervisão acusa um funcionário do REGISTO sem vigilância, e isso é um ponto cego.", "t_iso": "2026-09-25T10:54:59-03:00"}]}, "auditoria_claude": {"t_iso": "2026-09-25T12:23:03-03:00", "amostra": 12, "divergencias": 3, "exemplos": [{"funcionario": "telegram", "gravidade": "alta"}, {"funcionario": "x_grok", "gravidade": "alta"}, {"funcionario": "series", "gravidade": "baixa"}]}, "meta_frota": {"t_iso": "2026-09-25T13:48:04-03:00", "provedor": "cerebras", "amostra": 6, "concordam": 6, "discordam": 0, "divergencias": 0}, "publicado_em": "25/09 15:00:30"}