a vez Tesouraria-Arca para ver se o erro do agendador é passageiro. Se voltar a vermelho, fica com a pendência que já existe","Abrir pendência para a Revisao: corre sem produzir há 4 h","Abrir pendência para o telegram: declara uma saída que não existe","Abrir pendência para os 18 intervalos maus sem caso no auto-conserto (pesquisadores, aderencia, starks, limpeza: cerca de 120 min adiados pela trava de memória)"],"custo_usd":0.1456,"modelo":"opus","accoes":[{"tipo":"reiniciar_tarefa","alvo":"Tesouraria-Arca","decisao":"aplicar","razao":"dono: arca"},{"tipo":"abrir_pendencia","alvo":"Revisao T64 corre sem produzir há 4 h","decisao":"aplicar","razao":"vai para dados/enxame/pendencias_propostas.jsonl (ele promove)"},{"tipo":"abrir_pendencia","alvo":"Telegram T5 declara saída inexistente","decisao":"aplicar","razao":"vai para dados/enxame/pendencias_propostas.jsonl (ele promove)"},{"tipo":"abrir_pendencia","alvo":"18 intervalos maus sem caso no auto-conserto","decisao":"aplicar","razao":"vai para dados/enxame/pendencias_propostas.jsonl (ele promove)"}],"ultima_decisao":{"t_iso":"2026-10-23T10:23:04-03:00","lancou":true,"porque":"de hora a hora"},"corridas_hoje":{"stark":11,"auditoria":1},"propostas":[{"titulo":"18 intervalos maus sem caso no auto-conserto","porque":"Em 24 h houve 124 intervalos maus e 18 ficaram sem caso nem classificação (cobertura de 85,5%). Pesquisadores, aderencia, starks e limpeza ficaram cerca de 120 min adiados pela trava de memória","t_iso":"2026-10-23T10:25:43-03:00"},{"titulo":"Revisao T64 corre sem produzir há 4 h","porque":"A saída não mexe há 4 h, mais de 3x a cadência de 60 min, e o agendador diz ok","t_iso":"2026-10-23T10:25:43-03:00"},{"titulo":"Carteiro T76 morto pelo limite: p90 60 min = cadência","porque":"5 mortes pelo limite em 24 h e a saída parada há 4 h; reiniciar não resolve, porque volta a bater no limite de 60 min","t_iso":"2026-10-23T09:10:01-03:00"},{"titulo":"73 agentes gerentes partidos","porque":"Há 73 dos 1999 agentes p