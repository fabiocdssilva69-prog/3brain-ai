{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "3brain-api",
  "main": "src/index.js",

  // EXPLICITO de proposito. A pagina fala com o endereco workers.dev, e mexer
  // em rotas pode desliga-lo por padrao -- entao ele fica fixado aqui, e a
  // adicao do dominio proprio nao pode derrubar o chat que ja esta no ar.
  "workers_dev": true,
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },

  // Fallback sem chave nenhuma: o binding e injetado no runtime.
  "ai": { "binding": "AI" },

  // REGISTO DE DUVIDAS. O que os visitantes perguntam -- e sobretudo o que o
  // bot NAO soube responder -- e a materia-prima para a base crescer pelas
  // palavras DELES em vez das nossas. Escrita fora do caminho critico
  // (waitUntil) e dentro de try/catch: falhar aqui nunca derruba a resposta.
  "d1_databases": [
    { "binding": "DUVIDAS", "database_name": "duvidas-3brain",
      "database_id": "3fd7cedf-959f-4983-b3b9-2305000d957e" }
  ],

  // period so aceita 10 ou 60 segundos. Dois baldes: rajada e volume.
  "ratelimits": [
    { "name": "LIM_RAJADA", "namespace_id": "3001", "simple": { "limit": 3,  "period": 10 } },
    { "name": "LIM_MINUTO", "namespace_id": "3002", "simple": { "limit": 20, "period": 60 } }
  ],

  // Descomente quando 3brain.com.br estiver na Cloudflare com a zona Active.
  // Custom Domain, nao route: casa o hostname exato e cria DNS + certificado sozinho.
  "routes": [ { "pattern": "api.3brain.com.br", "custom_domain": true } ],

  "vars": {
    "MODELO_GROQ": "openai/gpt-oss-120b",
    "MODELO_CF": "@cf/openai/gpt-oss-120b",
    "ORIGENS": "https://fabiocdssilva69-prog.github.io,https://3brain.com.br,https://www.3brain.com.br"
  }
}
